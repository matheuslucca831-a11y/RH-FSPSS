# Copie para .env.local e preencha (Supabase > Project Settings > API)
# Use SOMENTE a chave "anon" ou "publishable". Nunca a service_role / secret.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Domínio que transforma a matrícula em login (matrícula@domínio). O sistema antigo usava rh12.com.
NEXT_PUBLIC_DOMINIO_LOGIN=rh12.com

# Endereço público do site (usado nas prévias de link)
NEXT_PUBLIC_SITE_URL=https://rh.seudominio.com.br
